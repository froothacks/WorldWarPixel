#pragma once

/* Copy this file to secrets.h (gitignored) and fill in your values.
 * The same firmware binary works for all three screens - only
 * DEVICE_TOKEN differs, and the token decides which society this
 * screen speaks for (token -> society index mapping lives on the
 * server in DEVICE_TOKENS="<tok0>:0,<tok1>:1,<tok2>:2"). */

#define WIFI_SSID      "your-ssid"
#define WIFI_PASSWORD  "your-password"

/* No trailing slash. ws:// vs wss:// is derived from the scheme. */
#define SERVER_URL     "http://192.168.1.50:8000"

/* Per-device bearer token issued by the server operator. */
#define DEVICE_TOKEN   "paste-token-here"
