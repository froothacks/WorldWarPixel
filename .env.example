# OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
MAX_CONCURRENCY=10
REQUEST_TIMEOUT=60
EVENT_LOG_PATH=events.db
MAX_ACTIVE_RUNS=4
# Model endpoints are defined in src/worldwarpixel/models.py together with the secrets each
# needs; set whichever you have. A preset with several endpoints (glm) spreads agents over
# all endpoints whose secrets are present. OPENAI_API_KEY enables the gpt-6-luna preset.
# Modal proxy auth (Modal-Key / Modal-Secret headers), one token pair per Modal workspace:
# advait-m (qwen, deepseek, glm)
MODAL_KEY=
MODAL_SECRET=
# chryztoph (glm, qwen-c)
CHRYZTOPH_MODAL_KEY=
CHRYZTOPH_MODAL_SECRET=
# meganwchun (glm)
MEGANWCHUN_MODAL_KEY=
MEGANWCHUN_MODAL_SECRET=
# Max tokens per agent call for presets without their own budget; raise for reasoning
# models that think before calling tools
# AGENT_MAX_TOKENS=700
# Max tokens per narrator update for presets without their own budget (default 700)
# NARRATOR_MAX_TOKENS=700
# Timelapse videos: rendered with ffmpeg when a run stops (TIMELAPSE_AUTO=true) into
# TIMELAPSE_DIR as {run_id}.mp4 + {run_id}.json; optionally mirrored to an S3-compatible bucket
# (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY from the env; set the endpoint for Cloudflare R2).
# TIMELAPSE_DIR=timelapses
# TIMELAPSE_DURATION=20
# TIMELAPSE_S3_BUCKET=
# TIMELAPSE_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# TIMELAPSE_S3_PREFIX=timelapses/
# Optional: lock god-mode endpoints (brush, clear, announce, pace); requests must then send X-God-Token
GOD_TOKEN=
# Speech panel voices: an OpenAI key, or TTS_BASE_URL for a local OpenAI-compatible service
TTS_API_KEY=
# TTS_BASE_URL=
TTS_MODEL=gpt-4o-mini-tts
