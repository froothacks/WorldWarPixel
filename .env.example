# OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
MAX_CONCURRENCY=10
REQUEST_TIMEOUT=60
EVENT_LOG_PATH=events.db
MAX_ACTIVE_RUNS=4
# Modal proxy auth for a dedicated inference endpoint (sent as Modal-Key / Modal-Secret headers)
MODAL_KEY=
MODAL_SECRET=
# Model used for agent turns (defaults to OPENAI_MODEL)
AGENT_MODEL=
# Extra agent models selectable at launch, "model=base_url,..." (same Modal credentials):
# AGENT_ENDPOINTS=larger=https://<larger-endpoint>/v1
# reasoning_effort for agent calls; "low" keeps thinking models (e.g. GLM) from rambling:
# AGENT_REASONING_EFFORT=low
# Agent models that get no canvas image (GLM reasons for minutes over images):
# AGENT_TEXT_ONLY=nvidia/GLM-5.3-Flash-NVFP4
# Model used for narrator updates (defaults to OPENAI_MODEL)
NARRATOR_MODEL=
# Optional: lock god-mode endpoints (brush, clear, announce, pace); requests must then send X-God-Token
GOD_TOKEN=
