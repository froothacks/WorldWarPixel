# OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
MAX_CONCURRENCY=10
REQUEST_TIMEOUT=60
EVENT_LOG_PATH=events.db
MAX_ACTIVE_RUNS=4
# Modal proxy auth for a dedicated inference endpoint (sent as Modal-Key / Modal-Secret headers)
MODAL_KEY=
MODAL_SECRET=
# Model used for agent turns (defaults to OPENAI_MODEL)
AGENT_MODEL=
# Model used for narrator updates (defaults to OPENAI_MODEL)
NARRATOR_MODEL=
# Optional: lock god-mode endpoints (brush, clear, announce, pace); requests must then send X-God-Token
GOD_TOKEN=
