# OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
MAX_CONCURRENCY=10
REQUEST_TIMEOUT=60
EVENT_LOG_PATH=events.db
MAX_ACTIVE_RUNS=4
# Modal proxy auth for the Modal-hosted model presets (qwen, deepseek); sent as
# Modal-Key / Modal-Secret headers. OPENAI_API_KEY enables the gpt-6-luna preset.
MODAL_KEY=
MODAL_SECRET=
# Endpoints of the Modal presets (defaults point at the project's own deployments)
# QWEN_BASE_URL=https://advait-m--ep-world-war-pixel-server.us-west.modal.direct/v1
# DEEPSEEK_BASE_URL=https://advait-m--ep-deepseek-v4-1-flash-server.us-west.modal.direct/v1
# Max tokens per agent call for presets without their own budget; raise for reasoning
# models that think before calling tools
# AGENT_MAX_TOKENS=700
# Max tokens per narrator update for presets without their own budget (default 700)
# NARRATOR_MAX_TOKENS=700
# Optional: lock god-mode endpoints (brush, clear, announce, pace); requests must then send X-God-Token
GOD_TOKEN=
